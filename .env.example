# PostgreSQL connection (pgAdmin / local Postgres)
# Replace USER, PASSWORD, and DATABASE with your pgAdmin credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# HMAC secret for signing JWTs (access + refresh). Use a long random string in production (32+ chars).
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: used by Next.js in production
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
