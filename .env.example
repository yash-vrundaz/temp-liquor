# PostgreSQL connection (pgAdmin / local Postgres)
# Replace USER, PASSWORD, and DATABASE with your pgAdmin credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# HMAC secret for signing JWTs (access + refresh).
# REQUIRED in production: sign-in returns 503 until this is set to a unique
# 32+ character value. Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: used by Next.js in production
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
